<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Activity Report</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
      font-size: 12px;
      color: #1e1e2e;
      background: #ffffff;
      padding: 36px 44px;
      line-height: 1.5;
    }

    /* ── Header ── */
    header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      border-bottom: 2px solid #1e1e2e;
      padding-bottom: 14px;
      margin-bottom: 28px;
    }
    header h1 { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
    header .period { font-size: 11px; color: #666; text-align: right; line-height: 1.7; }
    header .period span { display: block; }

    /* ── Summary cards ── */
    .summary {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 10px;
      margin-bottom: 28px;
    }
    .stat-card {
      background: #f5f5f7;
      border-radius: 6px;
      padding: 12px 10px;
      text-align: center;
    }
    .stat-card .num { font-size: 22px; font-weight: 700; color: #1e1e2e; }
    .stat-card .lbl { font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: #888; margin-top: 3px; }

    /* ── Repo section ── */
    .repo { margin-bottom: 32px; page-break-inside: avoid; }
    .repo-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #1e1e2e;
      color: #fff;
      padding: 10px 14px;
      border-radius: 6px 6px 0 0;
      font-size: 13px;
      font-weight: 600;
    }
    .repo-header .repo-name { letter-spacing: -0.01em; }
    .repo-meta { display: flex; gap: 16px; font-size: 11px; font-weight: 400; color: #aaa; }
    .repo-meta span { white-space: nowrap; }
    .repo-body {
      border: 1px solid #e0e0e0;
      border-top: none;
      border-radius: 0 0 6px 6px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    /* ── Section within a repo ── */
    .section-title {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #888;
      border-bottom: 1px solid #e8e8e8;
      padding-bottom: 5px;
      margin-bottom: 8px;
    }

    /* ── Tables ── */
    table { width: 100%; border-collapse: collapse; font-size: 11px; }
    th {
      text-align: left;
      font-size: 9px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #999;
      padding: 4px 8px;
      border-bottom: 1px solid #e8e8e8;
    }
    td { padding: 5px 8px; border-bottom: 1px solid #f2f2f2; vertical-align: top; }
    tr:last-child td { border-bottom: none; }
    tr:nth-child(even) td { background: #fafafa; }
    code { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 10px; background: #f0f0f0; padding: 1px 4px; border-radius: 3px; }

    /* ── State badges ── */
    .badge {
      display: inline-block;
      padding: 1px 6px;
      border-radius: 10px;
      font-size: 9px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .badge-open     { background: #e6f4ea; color: #1a7340; }
    .badge-closed   { background: #fce8e8; color: #b91c1c; }
    .badge-merged   { background: #ede9fe; color: #6d28d9; }
    .badge-success  { background: #e6f4ea; color: #1a7340; }
    .badge-failure  { background: #fce8e8; color: #b91c1c; }
    .badge-neutral  { background: #f3f4f6; color: #6b7280; }

    .empty { color: #bbb; font-size: 11px; font-style: italic; padding: 4px 0; }

    /* ── Footer ── */
    footer {
      margin-top: 36px;
      border-top: 1px solid #e0e0e0;
      padding-top: 10px;
      font-size: 10px;
      color: #aaa;
      display: flex;
      justify-content: space-between;
    }
  </style>
</head>
<body>

<header>
  <div>
    <h1>GitHub Activity Report</h1>
    <div style="font-size:12px;color:#555;margin-top:4px;">{{repoCount}} repositories tracked</div>
  </div>
  <div class="period">
    <span><strong>From</strong> {{periodStart}}</span>
    <span><strong>To</strong> {{periodEnd}}</span>
  </div>
</header>

<!-- ── Summary ── -->
<div class="summary">
  <div class="stat-card"><div class="num">{{totalCommits}}</div><div class="lbl">Commits</div></div>
  <div class="stat-card"><div class="num">{{totalPRs}}</div><div class="lbl">Pull Requests</div></div>
  <div class="stat-card"><div class="num">{{totalReleases}}</div><div class="lbl">Releases</div></div>
  <div class="stat-card"><div class="num">{{totalIssuesOpened}}</div><div class="lbl">Issues Opened</div></div>
  <div class="stat-card"><div class="num">{{totalIssuesClosed}}</div><div class="lbl">Issues Closed</div></div>
  <div class="stat-card"><div class="num">{{totalWorkflowRuns}}</div><div class="lbl">CI Runs</div></div>
</div>

<!-- ── Per-repo sections ── -->
{{#each repos}}
<div class="repo">
  <div class="repo-header">
    <span class="repo-name">{{this.owner}} / {{this.name}}</span>
    <div class="repo-meta">
      <span>{{this.stars}} stars</span>
      <span>{{this.forks}} forks</span>
    </div>
  </div>
  <div class="repo-body">

    <!-- Commits -->
    <div>
      <div class="section-title">Commits ({{this.commits.length}})</div>
      {{#if this.commits}}
      <table>
        <thead><tr><th>SHA</th><th>Message</th><th>Author</th><th>Date</th></tr></thead>
        <tbody>
          {{#each this.commits}}
          <tr>
            <td><code>{{this.sha}}</code></td>
            <td>{{this.message}}</td>
            <td>{{this.author}}</td>
            <td>{{this.date}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}<div class="empty">No commits in this period.</div>{{/if}}
    </div>

    <!-- Pull Requests -->
    <div>
      <div class="section-title">Pull Requests ({{this.pullRequests.length}})</div>
      {{#if this.pullRequests}}
      <table>
        <thead><tr><th>#</th><th>Title</th><th>State</th><th>Opened</th></tr></thead>
        <tbody>
          {{#each this.pullRequests}}
          <tr>
            <td>#{{this.number}}</td>
            <td>{{this.title}}</td>
            <td><span class="badge badge-{{this.state}}">{{this.state}}</span></td>
            <td>{{this.created_at}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}<div class="empty">No pull requests in this period.</div>{{/if}}
    </div>

    <!-- Releases -->
    <div>
      <div class="section-title">Releases ({{this.releases.length}})</div>
      {{#if this.releases}}
      <table>
        <thead><tr><th>Tag</th><th>Name</th><th>Published</th></tr></thead>
        <tbody>
          {{#each this.releases}}
          <tr>
            <td><code>{{this.tag_name}}</code></td>
            <td>{{this.name}}</td>
            <td>{{this.published_at}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}<div class="empty">No releases in this period.</div>{{/if}}
    </div>

    <!-- Issues Opened -->
    <div>
      <div class="section-title">Issues Opened ({{this.issuesOpened.length}})</div>
      {{#if this.issuesOpened}}
      <table>
        <thead><tr><th>#</th><th>Title</th><th>Opened</th></tr></thead>
        <tbody>
          {{#each this.issuesOpened}}
          <tr>
            <td>#{{this.number}}</td>
            <td>{{this.title}}</td>
            <td>{{this.created_at}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}<div class="empty">No issues opened in this period.</div>{{/if}}
    </div>

    <!-- Issues Closed -->
    <div>
      <div class="section-title">Issues Closed ({{this.issuesClosed.length}})</div>
      {{#if this.issuesClosed}}
      <table>
        <thead><tr><th>#</th><th>Title</th><th>Closed</th></tr></thead>
        <tbody>
          {{#each this.issuesClosed}}
          <tr>
            <td>#{{this.number}}</td>
            <td>{{this.title}}</td>
            <td>{{this.closed_at}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}<div class="empty">No issues closed in this period.</div>{{/if}}
    </div>

    <!-- CI / Workflow Runs -->
    <div>
      <div class="section-title">CI / Workflow Runs ({{this.workflowRuns.length}})</div>
      {{#if this.workflowRuns}}
      <table>
        <thead><tr><th>Workflow</th><th>Conclusion</th><th>Run At</th></tr></thead>
        <tbody>
          {{#each this.workflowRuns}}
          <tr>
            <td>{{this.name}}</td>
            <td><span class="badge badge-{{this.conclusion}}">{{this.conclusion}}</span></td>
            <td>{{this.created_at}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}<div class="empty">No workflow runs in this period.</div>{{/if}}
    </div>

  </div>
</div>
{{/each}}

<footer>
  <span>EDAE — GitHub Activity Report</span>
  <span>Generated {{periodEnd}}</span>
</footer>

</body>
</html>
